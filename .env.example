# ============================================================
# Campus Love 全栈环境变量示例（Task 8.1.5 + P1.19）
# ============================================================
# 部署时必须配置以下环境变量，应用才能正常启动。
#
# 使用方法：
#   1. 复制本文件为 .env（本地开发）或在系统环境变量中配置
#   2. 将下列占位符替换为真实值
#   3. 切勿将含真实凭据的 .env 文件提交到版本控制系统
#
# 安全提示：
#   - 所有 *_PASSWORD / *_SECRET / *_KEY 字段为敏感信息
#   - 所有敏感字段在本示例中均以 <PLACEHOLDER> 占位，禁止直接使用示例值上线
#   - 生产环境应通过密钥管理服务（如 Vault / AWS Secrets Manager）注入
#
# P1.19（2026-07-28）强制注入要求：
#   - docker-compose.yml 中所有密码字段使用 ${VAR:?error message} 形式
#   - 未设置环境变量时 docker compose 启动会失败（无弱默认值兜底）
#   - 必填字段：MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD / REDIS_PASSWORD /
#     JWT_SECRET / GRAFANA_ADMIN_PASSWORD
#   - 可选字段（默认空）：AGNES_API_KEY / WECHAT_SECRET / RABBITMQ_PASSWORD
#
# Generate secure secrets:
#   openssl rand -base64 48  # for JWT_SECRET
#   openssl rand -base64 32  # for DB_PASSWORD / MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD / REDIS_PASSWORD / RABBITMQ_PASSWORD
#   openssl rand -base64 32  # for AGNES_API_KEY / WECHAT_SECRET / GRAFANA_ADMIN_PASSWORD
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt(10)).decode())"  # for ADMIN_INITIAL_PASSWORD_HASH
# ============================================================

# ========== 1. JWT 配置（所有 profile 必须配置）==========
# JWT 签名密钥：必须 >= 32 字符（HS256 安全要求），建议 >= 48 字符随机串
# 生成示例：openssl rand -base64 48
JWT_SECRET=<PLACEHOLDER>
# JWT 令牌有效期（毫秒），默认 86400000 = 24 小时
JWT_EXPIRATION_MS=86400000

# ========== 2. 数据库配置（real profile 必须配置）==========
# 数据库连接 URL（MySQL 8 示例）
# 在 docker-compose 中无需配置，会自动指向 mysql 服务
DB_URL=jdbc:mysql://127.0.0.1:3306/campus_love?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# 数据库用户名
DB_USERNAME=campus
# 数据库密码（生产环境必须使用强密码）
DB_PASSWORD=<PLACEHOLDER>
# 数据库连接池最大连接数（可选，默认 20）
DB_POOL_MAX=20

# docker-compose MySQL 服务初始化参数
MYSQL_ROOT_PASSWORD=<PLACEHOLDER>
MYSQL_DATABASE=campus_love
MYSQL_USER=campus
MYSQL_PASSWORD=<PLACEHOLDER>
MYSQL_PORT=3306

# ========== 3. Redis 配置（real profile 必须配置）==========
# Redis 主机
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码（生产环境必须设置，未启用 auth 时留空）
REDIS_PASSWORD=<PLACEHOLDER>
# Redis 数据库索引（默认 0）
REDIS_DATABASE=0
# Redis 连接超时（毫秒）
REDIS_TIMEOUT=3000
# Redis 连接池配置
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
REDIS_POOL_MAX_WAIT=-1

# ========== 4. 管理员初始化配置（首次启动 Flyway 迁移用）==========
# 管理员 OpenID（⚠️ 生产部署必填：docker-compose 默认值为空，
# 不配置将无法初始化管理员；禁止使用公开默认值，防止被冒充登录，infra #8）
ADMIN_OPENID=
# 管理员昵称
ADMIN_NICKNAME=系统管理员
# 管理员密码 BCrypt 哈希
# - 默认值为强随机 BCrypt 哈希（无已知明文），无法用于实际登录
# - 首次部署必须通过环境变量 ADMIN_INITIAL_PASSWORD_HASH 覆盖为运营已知明文对应的哈希
# - 生成方法：
#     python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt(10)).decode())"
# - 首次登录后必须立即修改密码
ADMIN_INITIAL_PASSWORD_HASH=<PLACEHOLDER>

# ========== 5. 微信小程序配置（real profile 使用）==========
# 申请地址：https://mp.weixin.qq.com/
# AppID 格式：wx + 16 位十六进制字符（如 wx1234567890abcdef）
WECHAT_APPID=
# AppSecret：16 位字符串，与 AppID 配套申请，保密不外泄
WECHAT_SECRET=<PLACEHOLDER>

# ========== 5.1 Apple Sign in with Apple 配置（infra R2-00010,可选）==========
# bundle-id：本应用的 Bundle ID / App ID（Apple Developer 后台创建，如 com.campuslove.app）
# 未配置时 Apple 第三方登录不可用（登录接口返回 400）
APPLE_BUNDLE_ID=
# nonce：可选防重放随机数，前端生成并传入 identityToken 的 nonce 声明，需与后端一致
APPLE_NONCE=

# ========== 6. Agnes AI 视频/图片生成服务配置（SubTask 1.4.5）==========
# 申请地址：https://agnes-ai.com/dashboard/api-keys
AGNES_API_KEY=<PLACEHOLDER>
AGNES_API_BASE=https://api.agnes-ai.com/api
AGNES_TIMEOUT_MS=30000

# ========== 7. CORS 配置（可选）==========
# 允许的源列表（逗号分隔），生产环境必须配置具体域名（如 https://example.com）
# 当 allowCredentials=true 时禁止使用 *，必须使用 allowedOriginPatterns
# compose 默认值已含示例生产域名与本地开发地址，上线前请替换为真实域名（infra #41）
CORS_ALLOWED_ORIGINS=https://www.campuslove.example.com,https://admin.campuslove.example.com,http://localhost:5173,http://localhost:5174,http://localhost:5180

# ========== 8. RabbitMQ 配置（可选，real profile 使用，不可用时自动降级）==========
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=<PLACEHOLDER>
RABBITMQ_VHOST=/
RABBITMQ_CONNECTION_TIMEOUT=5000

# ========== 9. 应用运行时配置 ==========
# 应用端口（默认 8080）
APP_PORT=8080
# Flyway 迁移脚本位置（默认指向 ../../database/flyway/sql）
APP_FLYWAY_LOCATIONS=filesystem:../../database/flyway/sql
# 媒体存储根目录（默认 ./uploads）
APP_MEDIA_STORAGE_ROOT=./uploads
# 日志输出目录（默认 ./logs）
APP_LOGGING_PATH=./logs

# ========== 10. Docker Compose 端口映射 ==========
# 各服务的宿主机端口映射，避免端口冲突时调整
API_PORT=8080
ADMIN_PORT=5180
CLIENT_PORT=5173
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100

# ========== 11. 监控告警配置 ==========
# Grafana 管理员账号密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<PLACEHOLDER>
# 数据库备份保留天数（默认 7 天）
BACKUP_RETENTION_DAYS=7
# 备份 cron 表达式（默认每天凌晨 2 点；由 backup 服务启动命令写入 crontab，infra #20）
BACKUP_CRON=0 2 * * *
# 备份存储目录（容器内路径，与 ./backups 宿主目录 bind 挂载对齐，infra #16）
BACKUP_DIR=/backups
# 监控服务外部访问地址（默认本机，部署在反代/域名后时按需修改，infra #30）
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
GF_SERVER_ROOT_URL=http://localhost:3001
# 监控标签：环境标识（多环境部署时用于区分 dev/staging/prod，infra #44 / FIN-01329）
PROMETHEUS_ENVIRONMENT=production
# 部署环境标签（compose 服务 labels，FIN-00850）
DEPLOY_ENV=production

# ========== 11b. 告警通知渠道（Alertmanager，infra #17）==========
# ⚠️ prom/alertmanager 镜像不含 envsubst，alertmanager.yml 使用真实默认值+部署时替换策略：
# 请将以下变量对应值手动替换到 docker/alertmanager/alertmanager.yml 中相应字段
#（SMTP_HOST/SMTP_FROM/SMTP_USER/SMTP_PASSWORD → global；CRITICAL_EMAIL → critical-email；
#   DINGTALK_CRITICAL_WEBHOOK / FEISHU_WARNING_WEBHOOK / DEFAULT_WEBHOOK_URL → 各 receiver）
# 邮件 SMTP 服务器（如 smtp.qq.com:465 / smtp.exmail.qq.com:465）
SMTP_HOST=smtp.example.com:587
SMTP_FROM=alert@example.com
SMTP_USER=
SMTP_PASSWORD=<PLACEHOLDER>
# critical 告警收件人
CRITICAL_EMAIL=oncall@example.com
# 钉钉机器人 webhook（https://oapi.dingtalk.com/robot/send?access_token=xxx）
DINGTALK_CRITICAL_WEBHOOK=
# 飞书群机器人 webhook（https://open.feishu.cn/open-apis/bot/v2/hook/xxx）
FEISHU_WARNING_WEBHOOK=
# 默认归档 webhook（调试/归档用）
DEFAULT_WEBHOOK_URL=http://localhost:9999/webhook

# ========== 12. 上传与文件校验 ==========
# 上传文件大小上限（与后端 multipart.max-file-size 对齐）
APP_UPLOAD_MAX_FILE_SIZE=50MB
# 是否开启 MIME 与 magic bytes 校验（默认 true）
APP_UPLOAD_STRICT_VALIDATION=true

# ========== 13. 构建标签（CI/CD 用）==========
# Docker 镜像 tag。compose 默认 dev（infra #42：禁止 latest 默认上线，无法回滚）；
# 生产部署必须注入唯一版本：CI 推送 main/tag 时自动生成 ci-<sha>，
# 或手动指定 release tag（如 v1.2.0）
TAG=dev

# ========== 14. Swagger UI / OpenAPI 配置（Task 8.4.1）==========
# 是否启用 Swagger UI（infra #11：compose 生产默认 false，通过本变量覆盖）
# - true：开发/测试环境，可访问 /swagger-ui.html 调试接口
# - false：生产环境，关闭 Swagger UI 与 /v3/api-docs 端点
SWAGGER_UI_ENABLED=false
# OpenAPI 文档标题
OPENAPI_TITLE=校园恋爱小程序 API
# OpenAPI 文档版本
OPENAPI_VERSION=0.1.0
# OpenAPI 文档描述
OPENAPI_DESCRIPTION=校园恋爱小程序后端接口文档
# 联系人姓名
OPENAPI_CONTACT_NAME=Campus Love Dev Team
# 联系人邮箱
OPENAPI_CONTACT_EMAIL=dev@campuslove.example.com
# API 服务器地址（生产环境配置，如 https://api.campuslove.example.com）
OPENAPI_SERVER_URL=
# API 服务器描述
OPENAPI_SERVER_DESCRIPTION=Campus Love API Server
