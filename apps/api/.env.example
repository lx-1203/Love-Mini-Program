# ============================================================
# Campus Love API 环境变量示例
# ============================================================
# 部署时必须配置以下环境变量，应用才能正常启动。
#
# 使用方法：
#   1. 复制本文件为 .env（本地开发）或在系统环境变量中配置
#   2. 将下列占位符替换为真实值
#   3. 切勿将含真实凭据的 .env 文件提交到版本控制系统
#
# 安全提示：
#   - JWT_SECRET 和 DB_PASSWORD 是敏感信息，禁止硬编码到代码或配置文件
#   - 生产环境应通过密钥管理服务（如 Vault、AWS Secrets Manager）注入
#   - 生成安全 JWT 密钥：openssl rand -base64 48
# ============================================================

# ========== JWT 配置（所有 profile 必须配置）==========
# JWT 签名密钥：必须 >= 32 字符（HS256 安全要求），建议 >= 48 字符随机串
# 生成示例：openssl rand -base64 48
JWT_SECRET=your-secure-secret-key-at-least-32-chars-long
# JWT 令牌有效期（毫秒），默认 86400000 = 24 小时
JWT_EXPIRATION_MS=86400000

# ========== 数据库配置（real profile 必须配置，mock profile 不需要）==========
# 数据库连接 URL（MySQL 示例）
DB_URL=jdbc:mysql://127.0.0.1:3306/qihang_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# 数据库用户名
DB_USERNAME=root
# 数据库密码（生产环境必须使用强密码）
DB_PASSWORD=your-secure-database-password

# ========== 管理员初始化配置（首次启动 Flyway 迁移用，可选）==========
# 以下为 Flyway 迁移脚本占位符，仅首次启动初始化管理员账号时使用。
# 生产环境部署前必须修改为真实值。

# 管理员 OpenID（建议修改为唯一标识）
ADMIN_OPENID=admin-default-openid-change-me
# 管理员昵称
ADMIN_NICKNAME=系统管理员
# 管理员密码 BCrypt 哈希（对应明文 'Admin@2026'）
# ⚠️ 默认值为示例哈希（对应明文 'password'），仅用于开发/测试
# 生产环境必须通过 PasswordEncoderConfig.encodePassword("Admin@2026") 重新生成
# 首次登录后必须立即修改密码
ADMIN_PASSWORD_HASH=.20cQQubK3.HZWzG3YB1tlRy.fqvM/BG

# ========== 微信小程序配置（real profile 使用，mock profile 不需要）==========
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ========== 应用端口（可选，默认 8080）==========
APP_PORT=8080

# ========== Flyway 迁移脚本位置（可选，默认指向 ../../database/flyway/sql）==========
APP_FLYWAY_LOCATIONS=filesystem:../../database/flyway/sql