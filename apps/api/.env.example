# ============================================================
# Campus Love API 环境变量示例
# ============================================================
# 部署时必须配置以下环境变量，应用才能正常启动。
#
# 使用方法：
#   1. 复制本文件为 .env（本地开发）或在系统环境变量中配置
#   2. 将下列占位符替换为真实值
#   3. 切勿将含真实凭据的 .env 文件提交到版本控制系统
#
# 安全提示：
#   - JWT_SECRET、DB_PASSWORD、REDIS_PASSWORD、WECHAT_SECRET 是敏感信息，
#     禁止硬编码到代码或配置文件
#   - 生产环境应通过密钥管理服务（如 Vault、AWS Secrets Manager）注入
#   - 生成安全 JWT 密钥：openssl rand -base64 48
#   - 生成安全 BCrypt 哈希：python -c "import bcrypt; print(bcrypt.hashpw(b'PWD', bcrypt.gensalt(10)).decode())"
# ============================================================

# ========== JWT 配置（所有 profile 必须配置）==========
# JWT 签名密钥：必须 >= 32 字符（HS256 安全要求），建议 >= 48 字符随机串
# 生成示例：openssl rand -base64 48
JWT_SECRET=your-secure-secret-key-at-least-32-chars-long
# JWT 令牌有效期（毫秒），默认 86400000 = 24 小时
JWT_EXPIRATION_MS=86400000

# ========== 数据库配置（real profile 必须配置，mock profile 不需要）==========
# 数据库连接 URL（MySQL 示例）
DB_URL=jdbc:mysql://127.0.0.1:3306/qihang_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# 数据库用户名
DB_USERNAME=root
# 数据库密码（生产环境必须使用强密码）
DB_PASSWORD=your-secure-database-password
# 数据库连接池最大连接数（可选，默认 20）
DB_POOL_MAX=20

# ========== Redis 配置（real profile 必须配置，mock profile 不需要）==========
# Redis 主机
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码（生产环境必须设置，未启用 auth 时留空）
REDIS_PASSWORD=
# Redis 数据库索引（默认 0）
REDIS_DATABASE=0

# ========== 管理员初始化配置（首次启动 Flyway 迁移用）==========
# 以下为 Flyway 迁移脚本占位符，仅首次启动初始化管理员账号时使用。
# 生产环境部署前必须修改为真实值。

# 管理员 OpenID（建议修改为唯一标识）
ADMIN_OPENID=admin-default-openid-change-me
# 管理员昵称
ADMIN_NICKNAME=系统管理员
# Task 0.6.5：管理员密码 BCrypt 哈希
# - 默认值为强随机 BCrypt 哈希（无已知明文），无法用于实际登录
# - 首次部署必须通过环境变量 ADMIN_INITIAL_PASSWORD_HASH 覆盖为运营已知明文对应的哈希
# - 生成方法：
#     python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt(10)).decode())"
# - 或调用 PasswordEncoderConfig.encodePassword("YOUR-PASSWORD")
# - 首次登录后必须立即修改密码
ADMIN_INITIAL_PASSWORD_HASH=

# ========== 微信小程序配置（real profile 使用，mock profile 不需要）==========
# Task 0.6.3：环境变量命名规范统一为全大写 + 下划线
# 申请地址：https://mp.weixin.qq.com/
# AppID 格式：wx + 16 位十六进制字符（如 wx1234567890abcdef）
WECHAT_APPID=
# AppSecret：16 位字符串，与 AppID 配套申请，保密不外泄
WECHAT_SECRET=

# ========== Agnes AI 视频/图片生成服务配置（SubTask 1.4.5）==========
# 申请地址：https://agnes-ai.com/dashboard/api-keys
# - AGNES_API_KEY：Agnes AI API Key，缺失时 /api/ai/** 端点返回 401 AI_API_UNAUTHORIZED
# - AGNES_API_BASE：Agnes AI API 基础地址（可选，默认 https://api.agnes-ai.com/api）
# - AGNES_TIMEOUT_MS：调用 Agnes AI 接口的超时时间（毫秒，默认 30000）
AGNES_API_KEY=
AGNES_API_BASE=https://api.agnes-ai.com/api
AGNES_TIMEOUT_MS=30000

# ========== CORS 配置（可选，默认回退到本地开发端口）==========
# 允许的源列表（逗号分隔），生产环境必须配置具体域名（如 https://example.com）
# 当 allowCredentials=true 时禁止使用 *，必须使用 allowedOriginPatterns
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5177

# ========== RabbitMQ 配置（可选，real profile 使用，不可用时自动降级）==========
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# ========== 应用端口（可选，默认 8080）==========
APP_PORT=8080

# ========== Flyway 迁移脚本位置（可选，默认指向 ../../database/flyway/sql）==========
APP_FLYWAY_LOCATIONS=filesystem:../../database/flyway/sql

# ========== 媒体存储（可选，默认 ./uploads）==========
APP_MEDIA_STORAGE_ROOT=./uploads
