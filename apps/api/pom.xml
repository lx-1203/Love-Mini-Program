<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.1</version>
    <relativePath/>
  </parent>

  <groupId>com.campuslove</groupId>
  <artifactId>campus-love-api</artifactId>
  <version>0.1.0</version>
  <name>campus-love-api</name>
  <description>Campus love API skeleton for auth, growth config, and feedback flows.</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!-- Spring Security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- AOP 支持：用于审计日志切面（@Auditable 注解自动记录管理操作） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- spring-security-crypto：BCryptPasswordEncoder 所在依赖。
         spring-boot-starter-security 已传递引入，此处显式声明以便后续单独使用密码加密能力。 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- 修复：springdoc-openapi 提供 OpenAPI 3 + Swagger UI，自动生成接口文档。
         版本 2.5.0 适配 Spring Boot 3.x。访问 /swagger-ui.html 查看。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.5.0</version>
    </dependency>
    <!-- Redis：分布式缓存、Token 黑名单持久化、限流计数、分布式锁 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Micrometer + Prometheus：监控指标暴露到 /actuator/prometheus -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Bucket4j：API 速率限制（基于令牌桶算法） -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>8.10.1</version>
    </dependency>
    <!-- Spring AMQP：消息队列（异步消息推送、签到通知、匹配通知） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- Spring Retry：方法级重试，用于外部服务调用（微信API、短信等） -->
    <dependency>
      <groupId>org.springframework.retry</groupId>
      <artifactId>spring-retry</artifactId>
    </dependency>
    <!-- Apache Commons Pool2：Redis 连接池 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>
    <!-- Caffeine：本地缓存（L1 cache）。
         Task 2.3.1：作为 Redis 不可用时的降级方案，及单元测试环境下的轻量级 CacheManager。
         与 Spring Cache 抽象配合，通过 CaffeCacheManager 在 test/dev profile 下提供缓存能力。 -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Resilience4j：熔断/重试/限流/降级。
         Task 2.3.3：为微信 API/短信/对象存储等外部依赖提供韧性能力。
         spring-boot 3.x 适配版本 2.x。 -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- mockito-inline：支持 mock final 方法、static 方法、构造函数等。
         Spring Boot 3.3.1 默认携带的 mockito-core 不包含 inline mock maker，
         导致 IdempotentInterceptorTest / TraceIdFilterTest 中 mock HttpServletRequest
         等 final 类或其方法时无法正常工作。
         显式引入 mockito-inline 以启用 ByteBuddyInlineMockMaker。
         注意：Spring Boot 3.3.1 的 BOM 已不再托管 mockito-inline，需显式声明版本，
         与 mockito-core 5.2.0 保持一致。 -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-inline</artifactId>
      <version>5.2.0</version>
      <scope>test</scope>
    </dependency>
    <!-- spring-security-test：提供 @WithMockUser 等测试注解，供 SecurityConfigTest 使用 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.campuslove.api.CampusLoveApplication</mainClass>
          <!--
            分层打包（Spring Boot 2.3+ 特性）：
            将 jar 内容按变更频率拆分为多个 layer，配合 Docker multi-stage 构建
            可显著提升 Docker 镜像构建缓存命中率，缩短 CI/CD 构建时间。

            分层顺序（从下到上，变更频率从低到高）：
            - dependencies: 第三方依赖（变更频率最低）
            - spring-boot-loader: Spring Boot 启动器
            - snapshot-dependencies: SNAPSHOT 依赖
            - application: 应用自身代码（变更频率最高）

            使用方式：
              1. mvn package 后执行 java -Djarmode=layertools -jar target/*.jar list 查看分层
              2. Dockerfile 中按层 COPY，依赖未变更时复用缓存
          -->
          <layers>
            <enabled>true</enabled>
          </layers>
        </configuration>
      </plugin>
      <!-- JaCoCo 覆盖率插件：
           - prepare-agent：在测试启动时注入 agent，收集执行数据到 target/jacoco.exec
           - report：在 test 阶段生成 HTML/XML/CSV 覆盖率报告到 target/site/jacoco
           - check：在 verify 阶段校验覆盖率是否达标，未达标则构建失败
           阈值设定（P7 提升，与前端 vitest 阈值对齐至 80%）：
           - LINE     70 → 80：行覆盖率，业务核心代码应稳定覆盖
           - BRANCH   65 → 75：分支覆盖率，留出容差
           - METHOD   70 → 80：方法覆盖率，确保入口被调用
           - CLASS    65 → 75：类覆盖率，确保关键类被测
           若当前测试不满足，记录差距但不降低阈值，作为后续补全目标。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <!-- 测试前：注入 JaCoCo agent，收集执行数据 -->
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!-- 测试阶段：生成覆盖率报告（HTML + XML + CSV） -->
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- 校验阶段：按规则检查覆盖率是否达标 -->
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <!-- BUNDLE 级别：整个模块所有类的聚合指标 -->
                  <element>BUNDLE</element>
                  <limits>
                    <!-- 行覆盖率：≥ 80% -->
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <!-- 分支覆盖率：≥ 75% -->
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                    <!-- 方法覆盖率：≥ 80% -->
                    <limit>
                      <counter>METHOD</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <!-- 类覆盖率：≥ 75% -->
                    <limit>
                      <counter>CLASS</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
