<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.1</version>
    <relativePath/>
  </parent>

  <groupId>com.campuslove</groupId>
  <artifactId>campus-love-api</artifactId>
  <version>0.1.0</version>
  <name>campus-love-api</name>
  <description>Campus love API skeleton for auth, growth config, and feedback flows.</description>

  <properties>
    <java.version>17</java.version>
    <!-- Mockito 5.10.0+ 修复 JDK 21 下 MockMaker 初始化失败问题。
         旧版 Mockito (3.x/4.x/5.2.0) 与 byte-buddy 在 JDK 21 上无法初始化
         ByteBuddyInlineMockMaker，导致 "Could not initialize plugin: interface
         org.mockito.plugins.MockMaker" 错误，586/790 测试报 Error。
         Mockito 5.10.0 自带 byte-buddy 1.14.12，完全兼容 JDK 21。 -->
    <mockito.version>5.10.0</mockito.version>
    <byte-buddy.version>1.14.12</byte-buddy.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!-- Spring Security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- AOP 支持：用于审计日志切面（@Auditable 注解自动记录管理操作） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- spring-security-crypto：BCryptPasswordEncoder 所在依赖。
         spring-boot-starter-security 已传递引入，此处显式声明以便后续单独使用密码加密能力。 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- 修复：springdoc-openapi 提供 OpenAPI 3 + Swagger UI，自动生成接口文档。
         版本 2.5.0 适配 Spring Boot 3.x。访问 /swagger-ui.html 查看。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.5.0</version>
    </dependency>
    <!-- Redis：分布式缓存、Token 黑名单持久化、限流计数、分布式锁 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Redisson：分布式锁实现（Task 12.2 AutoRenewService 续费流程加锁防并发多扣）。
         基于 Redis 的可重入锁 RLock，支持锁自动续期与宕机释放。 -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
      <version>3.27.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Micrometer + Prometheus：监控指标暴露到 /actuator/prometheus -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Bucket4j：API 速率限制（基于令牌桶算法） -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>8.10.1</version>
    </dependency>
    <!-- Spring AMQP：消息队列（异步消息推送、签到通知、匹配通知） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- Spring Retry：方法级重试，用于外部服务调用（微信API、短信等） -->
    <dependency>
      <groupId>org.springframework.retry</groupId>
      <artifactId>spring-retry</artifactId>
    </dependency>
    <!-- Apache Commons Pool2：Redis 连接池 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>
    <!-- Caffeine：本地缓存（L1 cache）。
         Task 2.3.1：作为 Redis 不可用时的降级方案，及单元测试环境下的轻量级 CacheManager。
         与 Spring Cache 抽象配合，通过 CaffeCacheManager 在 test/dev profile 下提供缓存能力。 -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Resilience4j：熔断/重试/限流/降级。
         Task 2.3.3：为微信 API/短信/对象存储等外部依赖提供韧性能力。
         spring-boot 3.x 适配版本 2.x。 -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- mockito-core：Mockito 5.3+ 已将 inline mock maker 合并入 mockito-core，
         不再发布 mockito-inline artifact（5.2.0 为最后版本）。
         IdempotentInterceptorTest / TraceIdFilterTest 中 mock HttpServletRequest
         等 final 类或其方法依赖 ByteBuddyInlineMockMaker，Mockito 5.x 默认启用。
         JDK 21 兼容性：显式升级至 5.10.0，覆盖 Spring Boot 3.3.1 BOM 中的 5.2.0，
         与 byte-buddy 1.14.12 配合解决
         "Could not initialize plugin: interface org.mockito.plugins.MockMaker" 错误。 -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- byte-buddy：Mockito 5.10.0 需要 byte-buddy 1.14.10+ 才能在 JDK 21 上正常工作。
         显式声明版本以覆盖 Spring Boot 3.3.1 BOM 中较旧的 byte-buddy 版本，
         确保 ByteBuddyInlineMockMaker 在 JDK 21 模块系统下可正确初始化。
         注意：hibernate-core 6.5.2 声明 byte-buddy 为 runtime 依赖（懒加载代理/字节码增强），
         若本声明保留 test scope 会覆盖传递依赖的 runtime scope，导致打包 jar 缺失
         byte-buddy、运行时 EntityManagerFactory 初始化 NoClassDefFoundError（本地联调实测）。
         因此改为 runtime scope（同时满足测试与运行时）。 -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${byte-buddy.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <version>${byte-buddy.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- JNA：byte-buddy-agent 在 JDK 21 上 self-attach 时，若 HotSpot attachment
         provider 不可用，需要 JNA 作为后备 attachment provider。
         Mockito 报错 "No compatible attachment provider is available" 时，
         添加 JNA 可解决 byte-buddy-agent 的 dynamic agent 安装问题。
         参考错误信息："add JNA to the class path"。 -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.14.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
      <version>5.14.0</version>
      <scope>test</scope>
    </dependency>
    <!-- spring-security-test：提供 @WithMockUser 等测试注解，供 SecurityConfigTest 使用 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- maven-surefire-plugin：JDK 21 兼容性配置。
           JDK 9+ 模块系统限制了反射访问，导致 Mockito ByteBuddyInlineMockMaker
           在初始化时无法访问 java.base 模块中的非公开类。
           通过 add-opens 选项显式开放相关包给未命名模块，
           并启用 EnableDynamicAgentLoading 允许 byte-buddy 动态注入 agent。

           注意：使用 @{argLine} 而非 ${argLine} 实现延迟绑定，
           确保上方的 JaCoCo prepare-agent 通过设置 argLine 属性注入的
           jacocoagent.jar 仍能生效，覆盖率统计不会被覆盖。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED -XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.campuslove.api.CampusLoveApplication</mainClass>
          <!--
            分层打包（Spring Boot 2.3+ 特性）：
            将 jar 内容按变更频率拆分为多个 layer，配合 Docker multi-stage 构建
            可显著提升 Docker 镜像构建缓存命中率，缩短 CI/CD 构建时间。

            分层顺序（从下到上，变更频率从低到高）：
            - dependencies: 第三方依赖（变更频率最低）
            - spring-boot-loader: Spring Boot 启动器
            - snapshot-dependencies: SNAPSHOT 依赖
            - application: 应用自身代码（变更频率最高）

            使用方式：
              1. mvn package 后执行 java -Djarmode=layertools -jar target/*.jar list 查看分层
              2. Dockerfile 中按层 COPY，依赖未变更时复用缓存
          -->
          <layers>
            <enabled>true</enabled>
          </layers>
        </configuration>
      </plugin>
      <!-- maven-jar-plugin：排除 mock 包。
           SubTask 22.3：将 Mock 服务隔离到 com.campuslove.api.mock 包后，
           通过 maven-jar-plugin 在打包阶段排除该包，确保生产 jar 不含 Mock 类字节码。
           注意：target/classes 仍保留 mock 类供 test 编译/运行使用，
           仅最终 jar 产物排除。spring-boot-maven-plugin repackage 基于
           此 jar 产物，因此 fat jar 也不会包含 mock 类。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <excludes>
            <!-- 临时取消排除，使 mock 类在本地 mock 模式 jar 中可用 -->
            <!-- <exclude>com/campuslove/api/mock/**</exclude> -->
          </excludes>
        </configuration>
      </plugin>
      <!-- JaCoCo 覆盖率插件：
           - prepare-agent：在测试启动时注入 agent，收集执行数据到 target/jacoco.exec
           - report：在 test 阶段生成 HTML/XML/CSV 覆盖率报告到 target/site/jacoco
           - check：在 verify 阶段校验覆盖率是否达标，未达标则构建失败
           阈值设定（P7 提升，与前端 vitest 阈值对齐至 80%）：
           - LINE     70 → 80：行覆盖率，业务核心代码应稳定覆盖
           - BRANCH   65 → 75：分支覆盖率，留出容差
           - METHOD   70 → 80：方法覆盖率，确保入口被调用
           - CLASS    65 → 75：类覆盖率，确保关键类被测
           若当前测试不满足，记录差距但不降低阈值，作为后续补全目标。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <!-- 测试前：注入 JaCoCo agent，收集执行数据 -->
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <!-- 执行数据文件放到系统临时目录（通常为英文路径）：
                   项目路径含非 ASCII 字符（如 D:\6\恋爱小程序）时，
                   JaCoCo agent 在 Windows 上无法在默认 destfile
                   (${project.build.directory}/jacoco.exec，绝对路径含中文) 创建文件，
                   会静默失败导致执行数据缺失、覆盖率报告被跳过。
                   改用 ${java.io.tmpdir} 并在 report/check 中显式指定同一 dataFile，
                   各环境均可用（临时目录路径一般不含中文）。 -->
              <destFile>${java.io.tmpdir}/jacoco-${project.artifactId}.exec</destFile>
            </configuration>
          </execution>
          <!-- 测试阶段：生成覆盖率报告（HTML + XML + CSV） -->
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${java.io.tmpdir}/jacoco-${project.artifactId}.exec</dataFile>
            </configuration>
          </execution>
          <!-- 校验阶段：按规则检查覆盖率是否达标 -->
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${java.io.tmpdir}/jacoco-${project.artifactId}.exec</dataFile>
              <rules>
                <rule>
                  <!-- BUNDLE 级别：整个模块所有类的聚合指标 -->
                  <element>BUNDLE</element>
                  <limits>
                    <!-- 行覆盖率：≥ 80% -->
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <!-- 分支覆盖率：≥ 75% -->
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                    <!-- 方法覆盖率：≥ 80% -->
                    <limit>
                      <counter>METHOD</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <!-- 类覆盖率：≥ 75% -->
                    <limit>
                      <counter>CLASS</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
