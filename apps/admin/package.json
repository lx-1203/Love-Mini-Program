{
  "name": "@campus-love/admin",
  "private": true,
  "version": "0.1.0",
  "description": "Admin console (eladmin-style: dynamic menus + role permissions + multi-tab views), rebuilt from the eladmin reference.",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less",
    "*.vue",
    "*.vue?vue&type=style*",
    "*.vue?vue&type=template*",
    "@campus-love/admin/src/main.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "~2.1.7",
    "vue": "~3.4.0",
    "vue-i18n": "~9.14.2",
    "vue-router": "~4.3.0"
  },
  "devDependencies": {
    "@types/node": "~26.0.1",
    "@vitejs/plugin-vue": "~5.0.0",
    "typescript": "~5.3.0",
    "vite": "~5.4.0",
    "vitest": "~2.1.0",
    "vue-tsc": "~2.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <23.0.0",
    "npm": ">=9.0.0"
  }
}
