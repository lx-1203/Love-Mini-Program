# 开发环境配置（仅 vite dev 模式加载，生产构建不会读取此文件）
# 后端 API 基础地址
VITE_API_BASE_URL=http://127.0.0.1:8080/api

# 开发环境默认管理员凭据提示（仅占位，实际值由开发者本地配置覆盖）
# ⚠️ 安全警告：请勿提交真实凭据到代码仓库，开发者请在本地 .env.development.local 中覆盖
VITE_DEV_DEFAULT_USERNAME=
VITE_DEV_DEFAULT_PASSWORD=

# 开发环境管理员 token（Task 5：替代原 mock token 分支，由 .env.development.local 注入实际值）
# ⚠️ 安全警告：请勿提交真实 token 到代码仓库，开发者请在本地 .env.development.local 中覆盖
VITE_DEV_ADMIN_TOKEN=
