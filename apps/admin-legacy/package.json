{
  "name": "@campus-love/admin-legacy",
  "private": true,
  "version": "0.1.0",
  "description": "Legacy admin console (keep as rollback), superseded by the eladmin-style rebuilt admin.",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less",
    "*.vue",
    "*.vue?vue&type=style*",
    "*.vue?vue&type=template*",
    "@campus-love/admin-legacy/src/main.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "vue": "~3.4.0",
    "vue-router": "~4.3.0",
    "pinia": "~2.1.7",
    "vue-i18n": "~9.14.2"
  },
  "devDependencies": {
    "@types/node": "~26.0.1",
    "@vitejs/plugin-vue": "~5.0.0",
    "typescript": "~5.3.0",
    "vite": "~5.4.0",
    "vitest": "~2.1.0",
    "vue-tsc": "~2.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <21.0.0",
    "npm": ">=9.0.0"
  }
}
