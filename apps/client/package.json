{
  "name": "@campus-love/client",
  "private": true,
  "version": "0.1.0",
  "description": "Uni-app client workspace for the campus love app.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less",
    "*.vue",
    "*.vue?vue&type=style*",
    "*.vue?vue&type=template*",
    "@campus-love/client/src/main.ts",
    "@campus-love/client/src/App.vue"
  ],
  "scripts": {
    "dev:h5": "node scripts/prepare-static.mjs --h5 && uni --platform h5 --script dev-debug",
    "dev:h5:real": "uni --platform h5 --mode real",
    "build:h5": "node scripts/prepare-static.mjs --h5 && uni build --platform h5",
    "build:h5:real": "node scripts/prepare-static.mjs --h5 && node ../../scripts/verify-env-release.mjs && uni build --platform h5 --mode real",
    "dev:mp-weixin": "node scripts/prepare-static.mjs --dev && uni --platform mp-weixin --script dev-debug",
    "build:mp-weixin": "node scripts/prepare-static.mjs --dev && uni build --platform mp-weixin --mode mp-weixin && node ../../scripts/verify-package-size.mjs --allow-mock",
    "build:mp-weixin:showcase": "node scripts/prepare-static.mjs --dev && uni build --platform mp-weixin --mode mp-weixin-showcase",
    "build:mp-weixin:real": "node scripts/inject-wx-appid.mjs && node scripts/prepare-static.mjs --real && node ../../scripts/verify-env-release.mjs && node scripts/strip-mock-for-mp.mjs \"uni build --platform mp-weixin --mode real\" && node ../../scripts/verify-package-size.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check:tabbar": "node scripts/check-tabbar-consistency.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --config=../../tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=../../tests/e2e/playwright.config.ts",
    "test:a11y": "playwright test --grep=@a11y --config=../../tests/e2e/playwright.config.ts",
    "generate:openapi": "openapi-typescript ../../docs/openapi/feedback-growth-and-auth.yaml -o src/services/generated/api-types.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "uni-app": {
    "scripts": {
      "dev-debug": {
        "title": "开发模式（含 dev 调试页）",
        "env": {
          "NODE_ENV": "development"
        },
        "define": {
          "DEV": true
        }
      }
    }
  },
  "dependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-h5-vue": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-ui": "~1.5.12",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260525813",
    "@sentry-internal/browser-utils": "8.55.2",
    "@sentry-internal/feedback": "8.55.2",
    "@sentry-internal/replay": "8.55.2",
    "@sentry-internal/replay-canvas": "8.55.2",
    "@sentry/browser": "8.55.2",
    "@sentry/core": "8.55.2",
    "@sentry/vue": "~8.42.0",
    "@vueuse/core": "~11.3.0",
    "gsap": "~3.15.0",
    "pinia": "2.3.1",
    "vue": "3.4.21",
    "vue-i18n": "~9.14.2"
  },
  "devDependencies": {
    "@dcloudio/uni-components": "3.0.0-alpha-1000920260525813",
    "@vitejs/plugin-vue": "~5.0.0",
    "@vitest/coverage-v8": "~2.1.9",
    "@vue/test-utils": "~2.4.10",
    "jsdom": "~29.1.1",
    "sass": "~1.101.0",
    "sass-embedded": "~1.93.3",
    "typescript": "5.9.3",
    "vite": "~5.4.0",
    "vitest": "~2.1.0",
    "vue-tsc": "~2.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <21.0.0",
    "npm": ">=9.0.0"
  }
}
