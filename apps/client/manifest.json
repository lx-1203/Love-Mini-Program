{
  "name": "校园恋爱",
  "appid": "__UNI__CAMPUSLOVE",
  "description": "校园恋爱 uni-app 客户端",
  "versionName": "0.1.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true
  },
  "mp-weixin": {
    "appid": "__WX_APPID_PLACEHOLDER__",
    "setting": {
      "urlCheck": true,
      "es6": true
    },
    "usingComponents": true,
    "__usePrivacyCheck__": true,
    "permission": {
      "scope.userLocation": {
        "desc": "你的位置信息将用于校园恋爱匹配附近的同学"
      },
      "scope.userInfo": {
        "desc": "用于完善你的个人资料"
      },
      "scope.camera": {
        "desc": "用于视频通话与头像拍摄"
      },
      "scope.record": {
        "desc": "用于语音消息与语音通话"
      },
      "scope.writePhotosAlbum": {
        "desc": "用于保存图片到你的相册"
      }
    },
    "requiredPrivateInfos": [
      "getLocation",
      "chooseLocation",
      "chooseAddress"
    ]
  },
  "h5": {
    "title": "校园恋爱"
  }
}
