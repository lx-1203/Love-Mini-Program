# 本地 mock 联调构建（2026-08-26 新增，不污染 .env.mp-weixin 的 real 默认）
# 用法：uni build --platform mp-weixin --mode mp-weixin-mock（npm run build:mp-weixin:mock）
# 说明：mock 模式下前端业务请求全部走本地 fixtures（零网络），无后端也能演示全功能；
#       ⚠️ 严禁携带 mock 配置发布生产包（发布请用 build:mp-weixin / build:mp-weixin:real）。
VITE_API_MODE=mock
# mock 模式不发起真实请求，base 仅作兜底占位
VITE_API_BASE_URL=http://127.0.0.1:8080/api
VITE_APP_VERSION=v0.1.0