<!-- P6 a11y：TabBar 添加 role=tablist / role=tab / aria-selected / aria-label
     微信小程序原生 wxml 支持 role 与 aria-* 属性，可直接渲染到 DOM -->
<view class="tab-bar" role="tablist" aria-label="主导航">
  <view
    wx:for="{{tabs}}"
    wx:key="id"
    class="tab-bar__item {{item.prominent ? 'tab-bar__item--prominent' : ''}} {{index === selected ? 'tab-bar__item--active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    role="tab"
    aria-selected="{{index === selected ? 'true' : 'false'}}"
    aria-label="{{item.label}}"
  >
    <view class="tab-bar__icon-wrap">
      <image
        class="tab-bar__icon"
        src="{{index === selected ? item.activeIconPath : item.iconPath}}"
        mode="aspectFit"
        alt=""
        aria-hidden="true"
      />
      <!-- A2：消息 Tab 未读角标（红点数字，>99 显示 "99+"；chatBadge 由 syncBadge 从 storage 同步） -->
      <view
        wx:if="{{item.id === 'chat' && chatBadge > 0}}"
        class="tab-bar__badge"
        aria-hidden="true"
      >
        <text class="tab-bar__badge-text">{{chatBadge > 99 ? '99+' : chatBadge}}</text>
      </view>
    </view>
    <text class="tab-bar__label">{{item.label}}</text>
    <view wx:if="{{index === selected}}" class="tab-bar__indicator" aria-hidden="true"></view>
  </view>
</view>
