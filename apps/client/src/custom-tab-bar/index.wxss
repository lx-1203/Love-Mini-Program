/* ============================================================
 * 自定义 TabBar 样式（mp-weixin 原生 tabBar）
 * 设计需求对齐：
 *  - 全宽固定于屏幕最底部，高度 56px + 底部安全区
 *  - 激活态品牌主色 #36C99A（图标+文字），非激活态中性深灰 #6B7280
 *    （修复 P2 颜色对比度，对比度 4.6:1 满足 WCAG AA）
 *  - 图标+文字组合，无冗余动画，点击即时切换
 * ============================================================ */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  height: calc(160rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: content-box;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.tab-bar__item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  border: 0;
  background: transparent;
  /* 修复 P2（颜色对比度不足）：#9AA1AB → #6B7280，对比度从 ~2.85:1 提升至 ~4.6:1，达到 WCAG AA 4.5:1 标准 */
  /* R4-00242：颜色走 --c-text-tertiary（= #6B7280）design token */
  color: var(--c-text-tertiary, #6B7280);
  font-size: 20rpx;
  line-height: 1;
}

/* 激活态文字主色：青藤绿 #36C99A（R4-00242：走 --c-brand token） */
.tab-bar__item--active {
  color: var(--c-brand, #36C99A);
}

.tab-bar__icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar__label {
  font-size: 20rpx;
  font-weight: 500;
}

.tab-bar__item--active .tab-bar__label {
  font-weight: 600;
}

/* ============================================================
 * A2：激活态指示条（选中项底部绿色小横条，设计稿 48rpx×6rpx 圆角）
 * ============================================================ */
.tab-bar__indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  /* R4-00242：走 --c-brand design token，与激活态文字同源 */
  background: var(--c-brand, #36C99A);
}

/* ============================================================
 * A2：消息 Tab 未读角标（图标右上角红点数字）
 * ============================================================ */
.tab-bar__icon-wrap {
  position: relative;
}

.tab-bar__badge {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full, 9999rpx);
  /* A2：红点用 --c-error design token（= #E5454D） */
  background: var(--c-error, #E5454D);
}

.tab-bar__badge-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--c-text-inverse, #ffffff);
}

/* ============================================================
 * 中央「匹配」浮岛（纯匹配版设计：绿色圆形 + 白色爱心）
 * 唯一凸起项：icon-wrap 上移并放大为圆形浮岛，标签品牌绿
 * ============================================================ */
.tab-bar__item--prominent {
  color: #36C99A;
}

.tab-bar__item--prominent .tab-bar__icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-full, 9999rpx);
  background: linear-gradient(135deg, #36C99A 0%, #55D5A7 100%);
  box-shadow: 0 8rpx 32rpx rgba(54, 201, 154, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -40rpx;
}

.tab-bar__item--prominent .tab-bar__icon {
  width: 72rpx;
  height: 72rpx;
}

.tab-bar__item--prominent .tab-bar__label {
  color: #36C99A;
  font-weight: 600;
}

/* 2026-08-31：全屏弹层期间隐藏（配合 getTabBar().setData({hidden:true})） */
.tab-bar--hidden {
  transform: translateY(110%);
  pointer-events: none;
}
