/* ============================================================
 * 自定义 TabBar 样式（mp-weixin 原生 tabBar）
 * 设计需求对齐：
 *  - 全宽固定于屏幕最底部，高度 56px + 底部安全区
 *  - 激活态品牌主色 #3FCF8E（图标+文字），非激活态中性深灰 #6B7280
 *    （修复 P2 颜色对比度，对比度 4.6:1 满足 WCAG AA）
 *  - 图标+文字组合，无冗余动画，点击即时切换
 * ============================================================ */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  /* R4-00242：颜色走 design token（page 级 CSS 变量可级联到自定义 tabBar），
     与 theme/design-variables.scss 双源一致，改品牌色只需改 token 一处 */
  background: var(--c-bg-container, #ffffff);
  border-top: 1rpx solid var(--c-divider-light, rgba(15, 23, 42, 0.06));
}

.tab-bar__item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  border: 0;
  background: transparent;
  /* 修复 P2（颜色对比度不足）：#9AA1AB → #6B7280，对比度从 ~2.85:1 提升至 ~4.6:1，达到 WCAG AA 4.5:1 标准 */
  /* R4-00242：颜色走 --c-text-tertiary（= #6B7280）design token */
  color: var(--c-text-tertiary, #6B7280);
  font-size: 20rpx;
  line-height: 1;
}

/* 激活态文字主色：青藤绿 #3FCF8E（R4-00242：走 --c-brand token） */
.tab-bar__item--active {
  color: var(--c-brand, #3FCF8E);
}

.tab-bar__icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar__label {
  font-size: 20rpx;
  font-weight: 500;
}

.tab-bar__item--active .tab-bar__label {
  font-weight: 600;
}

/* ============================================================
 * A2：激活态指示条（选中项底部绿色小横条，设计稿 48rpx×6rpx 圆角）
 * ============================================================ */
.tab-bar__indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  /* R4-00242：走 --c-brand design token，与激活态文字同源 */
  background: var(--c-brand, #3FCF8E);
}

/* ============================================================
 * A2：消息 Tab 未读角标（图标右上角红点数字）
 * ============================================================ */
.tab-bar__icon-wrap {
  position: relative;
}

.tab-bar__badge {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full, 9999rpx);
  /* A2：红点用 --c-error design token（= #E5454D） */
  background: var(--c-error, #E5454D);
}

.tab-bar__badge-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--c-text-inverse, #ffffff);
}
