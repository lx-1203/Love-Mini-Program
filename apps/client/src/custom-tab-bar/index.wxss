/* ============================================================
 * 自定义 TabBar 样式（mp-weixin 原生 tabBar）
 * 设计需求对齐：
 *  - 全宽固定于屏幕最底部，高度 56px + 底部安全区
 *  - 激活态品牌主色 #3FCF8E（图标+文字），非激活态中性深灰 #6B7280
 *    （修复 P2 颜色对比度，对比度 4.6:1 满足 WCAG AA）
 *  - 图标+文字组合，无冗余动画，点击即时切换
 * ============================================================ */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: #ffffff;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.tab-bar__item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1;
  border: 0;
  background: transparent;
  /* 修复 P2（颜色对比度不足）：#9AA1AB → #6B7280，对比度从 ~2.85:1 提升至 ~4.6:1，达到 WCAG AA 4.5:1 标准 */
  color: #6B7280;
  font-size: 20rpx;
  line-height: 1;
}

/* 激活态文字主色：青藤绿 #3FCF8E */
.tab-bar__item--active {
  color: #3FCF8E;
}

.tab-bar__icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar__label {
  font-size: 20rpx;
  font-weight: 500;
}

.tab-bar__item--active .tab-bar__label {
  font-weight: 600;
}
