export type ProfileContentType =
  | "story"
  | "photo"
  | "voice"
  | "post"
  | "moment";

export type ProfileContentVisibility = "public" | "private";

export interface ProfileContentItem {
  id: string;
  type: ProfileContentType;
  cover: string;
  title: string;
  content: string;
  createdAt: string;
  visibility: ProfileContentVisibility;
}
