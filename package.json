{
  "name": "campus-love-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/client",
    "apps/admin"
  ],
  "scripts": {
    "api:dev": "node tools/run-api-wrapper.cjs spring-boot:run -Dspring-boot.run.profiles=mock",
    "api:test": "node tools/run-api-wrapper.cjs test",
    "api:verify": "node tools/run-api-wrapper.cjs verify -Dspring-boot.repackage.skip=true",
    "client:dev:h5": "npm --workspace apps/client run dev:h5",
    "client:dev:h5:real": "npm --workspace apps/client run dev:h5:real",
    "generate:openapi": "npm --workspace apps/client run generate:openapi",
    "lint": "eslint apps/admin/src apps/client/src tools eslint.config.mjs",
    "lint:openapi": "node tools/lint-openapi.mjs docs/openapi/feedback-growth-and-auth.yaml docs/openapi/likes.yaml docs/openapi/village.yaml docs/openapi/recommendations.yaml docs/openapi/users.yaml docs/openapi/check-in.yaml docs/openapi/notifications.yaml docs/openapi/official-accounts.yaml docs/openapi/whispers.yaml",
    "lint:openapi:spectral": "spectral lint \"docs/openapi/*.yaml\"",
    "test:prototype": "node tests/prototype-contract.spec.mjs",
    "test:structure": "node tests/project-structure.spec.mjs",
    "test:deployment-config": "node tests/deployment-config.spec.mjs",
    "test:ci-contract": "node tests/ci-contract.spec.mjs",
    "test:final-verify-summary": "node tests/final-verify-summary.spec.mjs",
    "test:r16-ledger": "node tests/r16-disposition-ledger.spec.mjs",
    "test:e2e-routes": "node tests/e2e-routes.spec.mjs",
    "test:e2e-types": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test:admin-write-gate": "node tests/admin-write-gate.spec.mjs",
    "test:admin-scope-leak": "node tests/admin-scope-leak.spec.mjs",
    "test:collation-uniform": "node tests/collation-uniform.spec.mjs",
    "test:entity-ddl-drift": "node tests/entity-ddl-drift.spec.mjs",
    "test:admin-scope-parity": "node tests/admin-scope-parity.spec.mjs",
    "test:audit-ratchet": "node tools/audit-prod-ratchet.mjs",
    "test:tz-ratchet": "node tests/tz-ratchet.spec.mjs",
    "test:openapi-coverage": "node tests/openapi-coverage.spec.mjs",
    "test:admin-credential": "node tests/admin-credential-gate.spec.mjs",
    "test:release-gate": "node tests/release-gate.spec.mjs",
    "test:docs": "node tests/docs-contract.spec.mjs",
    "test:env-release": "node scripts/verify-env-release.mjs --self-test",
    "test:binding-audit-sql": "node tests/third-party-binding-audit.spec.mjs",
    "test:build-band": "node apps/client/scripts/mark-build-band.mjs --self-test",
    "test:monitoring": "node tests/monitoring-wiring.spec.mjs",
    "test:tracked-refs": "node scripts/qa/check-tracked-references.mjs --strict",
    "test:tracked-refs:self-test": "node scripts/qa/check-tracked-references.mjs --self-test",
    "test:fidelity-manifest": "node scripts/qa/check-fidelity-manifest.mjs --strict",
    "test:fidelity-manifest:self-test": "node scripts/qa/check-fidelity-manifest.mjs --self-test",
    "test:fallback-ratchet": "node scripts/qa/audit-fallback-literals.cjs --ratchet",
    "test:fallback-ratchet:self-test": "node scripts/qa/audit-fallback-literals.cjs --self-test",
    "test:asset-coverage:source": "node scripts/qa/verify-app-assets-coverage.mjs --source-only",
    "test:asset-coverage:source:self-test": "node scripts/qa/verify-app-assets-coverage.mjs --source-only --selftest",
    "test:gate-list-sync": "node scripts/qa/verify-gate-list-sync.cjs",
    "test:data-hygiene": "node scripts/qa/verify-data-hygiene.mjs",
    "test:data-hygiene:self-test": "node scripts/qa/verify-data-hygiene.mjs --self-test",
    "test:asset-registry": "node scripts/qa/verify-asset-registry.mjs",
    "test:asset-registry:self-test": "node scripts/qa/verify-asset-registry.mjs --self-test",
    "test:contracts": "npm run test:prototype && npm run test:structure && npm run test:deployment-config && npm run test:ci-contract && npm run test:fidelity-manifest && npm run test:fidelity-manifest:self-test && npm run test:final-verify-summary && npm run test:r16-ledger && npm run test:e2e-routes && npm run test:e2e-types && npm run test:admin-write-gate && npm run test:admin-scope-leak && npm run test:admin-scope-parity && npm run test:admin-credential && npm run test:tz-ratchet && npm run test:collation-uniform && npm run test:entity-ddl-drift && npm run test:openapi-coverage && npm run test:release-gate && npm run test:docs && npm run test:env-release && npm run test:binding-audit-sql && npm run test:fallback-ratchet && npm run test:fallback-ratchet:self-test && npm run test:tracked-refs && npm run test:tracked-refs:self-test && npm run test:build-band && npm run test:monitoring && npm run test:gate-wiring && npm run test:asset-coverage:source:self-test && npm run test:gate-list-sync && npm run test:data-hygiene:self-test && npm run test:asset-registry:self-test",
    "test:gate-wiring": "node tests/gate-wiring.spec.mjs",
    "test:admin": "pnpm --filter @campus-love/admin run test:unit",
    "test:coverage": "pnpm --filter @campus-love/client run test:coverage",
    "test:client": "npm run generate:openapi && npm --workspace apps/client run test:unit",
    "test": "npm run test:contracts && npm run test:admin && npm run test:coverage && npm run api:verify && npm run test:client",
    "verify:client-builds": "node tools/verify-client-builds.mjs",
    "verify:phase01": "npm run test && npm run lint:openapi && npm run lint:openapi:spectral && npm --workspace apps/client run typecheck && npm run verify:client-builds && npm run api:verify",
    "lighthouse:client": "lighthouse http://localhost:5173 --output=html --output-path=./test-screenshots/lighthouse-client.html --only-categories=performance --preset=desktop",
    "lighthouse:admin": "lighthouse http://localhost:5177 --output=html --output-path=./test-screenshots/lighthouse-admin.html --only-categories=performance --preset=desktop",
    "lighthouse:ci": "lhci autorun --config=config/lighthouserc.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "~0.13.0",
    "@playwright/test": "1.49.1",
    "@stoplight/spectral-cli": "~6.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "json5": "2.2.3",
    "lighthouse": "~11.0.0",
    "openapi-typescript": "~7.13.0",
    "puppeteer": "~24.43.1",
    "sharp": "~0.34.5",
    "typescript-eslint": "^8.65.0",
    "yaml": "~2.5.0"
  },
  "engines": {
    "node": ">=18.0.0 <23.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
