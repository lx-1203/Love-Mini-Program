{
 "kind": "case-recipes",
 "note": "能力解锁腿的逐例配方通道（capability 车道 2026-10-06）。键=判据台复合 id（与 verify-real-coverage 的 manifest|id 同源同写法）。每一例只含：只读前置（query/page）、可回滚夹具（fixture 必带 teardown，decisions#6 卫生裁定同向：跑完恢复原态、不留测试残留）、驱动脚本（modalScript/netFault）、多步序列（steps，逐步断言落点并逐步留帧）。夹具操作子（op）的 via 词表：api（产品 API；admin:true 走后台管理员票）、store-call（应用内 pinia action，走产品自己的 API 链路）、store-patch（会话内状态注入）、store-cleanup（会话内数组摘除）。选择器约定（REAL-OT-06，2026-10-10）：目标类名在自定义组件子树内时写「>>>」分段穿透链（如 profile-shell >>> public-profile >>> relationship-c-t-a >>> .relationship-cta__btn--like），r-exec-ws 的探针/tap/rapidTap/input/readValue 逐层 element.$ 下钻；段与段之间以真实编译标签/类名为准（抄 dist/build/mp-weixin-real 对应 wxml/json，不许凭源码猜）。判据台 tapTarget 仍记平铺类名，穿透链以它结尾即可被子串校验命中。消费方 scripts/qa/r-exec-ws.mjs（--recipes）；交叉校验 scripts/qa/test-cap-recipes.cjs（配方键必须在判据台存在、tapTarget 必须被步骤覆盖、夹具必须可回滚）。",
 "hygiene": "夹具纪律：零写库；admin 凭据只运行期读 apps/api/restart-backend.ps1，绝不上命令行/日志；store 注入的 teardown 显式恢复原值；OT06/OC09 的游客轴不在本通道管辖（页不在 guest-landing-policy.json，摘轴是落点裁定非能力问题）⇒ 本文件只配登录轴。",
 "recipes": {
  "PAGES-PROFILE-INDEX|PFI25": {
   "page": "pages/profile/index",
   "caps": { "nativeModal": true },
   "fixture": {
    "why": "pre=「接 PFI23 已有语音状态」。real 档 fetchProfile 不回填语音（stores/profile.ts real 分支无 voiceStatusUrl 映射，后端 profile 无语音字段）⇒ 语音态只能会话内注入：pinia profile store 写 voiceStatusUrl/Duration（零后端写入），teardown 调 clearVoiceStatus 恢复初值。判据 ③ 的「服务端回读语音字段」半边在 real 档无对象（后端本就不持久化该字段）—— 行上如实记，不冒充。",
    "setup": [
     { "name": "seed-voice", "via": "store-patch", "store": "profile", "patch": { "voiceStatusUrl": "https://qa-carrier.example/qa-voice.mp3", "voiceStatusDuration": 3 } }
    ],
    "teardown": [
     { "name": "clear-voice", "via": "store-call", "store": "profile", "call": "clearVoiceStatus" }
    ]
   },
   "modalScript": {
    "showModal": { "answers": [ { "confirm": false }, { "confirm": true } ] }
   },
   "why": "pre=「接 PFI23 已有语音状态」。real 档 fetchProfile 不回填语音（stores/profile.ts real 分支无 voiceStatusUrl 映射，后端 profile 无语音字段）⇒ 语音态只能会话内注入：pinia profile store 写 voiceStatusUrl/Duration（零后端写入），teardown 调 clearVoiceStatus 恢复初值。判据 ③ 的「服务端回读语音字段」半边在 real 档无对象（后端本就不持久化该字段）—— 行上如实记，不冒充。动作 ③ 的复位靠重新 open 同页（同一 app 会话内 store 不销毁）。",
   "adjudication": "R2-PFI25-04/R2-02 定谳（2026-10-10）：三次 FAILED（b1/b1b/fixlane）的丢弃点=测试编排，不是产品渲染链——(a) 源码定谳：stores/profile.ts load() real 分支（:415-469）不赋 voiceStatusUrl/Duration（仅 mock 分支 :401-402 赋值），fetchProfile（:498）委托 load ⇒ 「fetchProfile 覆盖」不成立；(b) 通道定谳：open 步走 ideCall simulator_open_page，skill tool-index 载明属 compiler 族「触发项目窗口模拟器编译并打开指定页」，且 tour-ledger CON-EV-01 实测在册「桥开页重启 AppService（包装器/缓冲全灭 i=0|n=-1）」⇒ open=重编译重启，open 之前的 seed 必灭。故本配方把 seed-voice 移到首次 open 之后（活应用上打补丁），并在 assert 前配 read(profile-voice-state)+probe(.video-cta/.voice-preview) 渲染-存储对照；「真删」判据由同页 confirm 后 assertAbsent 承担（重开步经重编译清态，对该判点无判别力，行上如实记不读作删除证据）。原 probe 里 .profile-complete-card 为死选择器（src 与编译产物均无此类名）已摘除。",
   "steps": [
    { "do": "open", "page": "pages/profile/index" },
    { "do": "wait", "ms": 2200 },
    { "do": "fixture", "phase": "setup" },
    { "do": "wait", "ms": 800 },
    { "do": "read", "expr": "profile-voice-state", "label": "渲染时 store 语音态（与下步 probe 配对定谳）" },
    { "do": "probe", "selectors": [".video-cta", ".voice-preview", ".voice-preview__delete"] },
    { "do": "assertPresent", "selector": ".voice-preview__delete" },
    { "do": "shot", "label": "a-before-delete" },
    { "do": "armModal" },
    { "do": "tap", "selector": ".voice-preview__delete" },
    { "do": "wait", "ms": 1100 },
    { "do": "drainModal", "expect": 1 },
    { "do": "assertPresent", "selector": ".voice-preview__delete" },
    { "do": "shot", "label": "b-after-cancel" },
    { "do": "tap", "selector": ".voice-preview__delete" },
    { "do": "wait", "ms": 1100 },
    { "do": "drainModal", "expect": 2 },
    { "do": "assertAbsent", "selector": ".voice-preview__delete" },
    { "do": "shot", "label": "c-after-confirm" },
    { "do": "open", "page": "pages/profile/index" },
    { "do": "wait", "ms": 2400 },
    { "do": "read", "expr": "profile-voice-state", "label": "重进后 store 语音态（重开=重编译清态，本步对「真删」无判别力，读数照实记）" },
    { "do": "assertAbsent", "selector": ".voice-preview__delete" },
    { "do": "shot", "label": "d-reenter" },
    { "do": "restoreModal" },
    { "do": "fixture", "phase": "teardown" }
   ]
  },
  "SUBPACKAGES-VILLAGE-VILLAGE-INDEX|VI25": {
   "page": "subpackages/village/village/index",
   "caps": { "fixtureApi": true },
   "fixture": {
    "why": "pre=「身份A 先发一条新帖（进审核流）」。setup 走应用内 village store 的 createPost action（产品自己的 POST /api/v1/posts 链路，同时把帖子插进 selfPendingPosts 置顶——与经底部输入条发布同一条产品代码路径，判据的 action 从「发布成功后」才开始）；teardown 用后台 DELETE 撤帖 + store-cleanup 把会话内 selfPendingPosts/posts 数组里的该 id 摘掉 —— 走 API 不写库，跑完广场零残留。",
    "setup": [
     { "name": "create-pending-post", "via": "store-call", "store": "village", "call": "createPost",
       "args": { "title": "QA回滚夹具帖 qa-vi25-{ts}", "content": "能力解锁腿 VI25 的可回滚夹具帖（跑完即由后台 DELETE 撤除）。qa-vi25-{ts}" },
       "capture": "postId", "capturePath": "id" }
    ],
    "teardown": [
     { "name": "delete-pending-post", "via": "api", "admin": true, "method": "DELETE", "path": "/api/v1/admin/forum/village-posts/{captured.postId}", "expectStatus": [200, 204] },
     { "name": "store-cleanup", "via": "store-cleanup", "store": "village", "arrays": ["selfPendingPosts", "posts"], "byId": "{captured.postId}" }
    ]
   },
   "steps": [
