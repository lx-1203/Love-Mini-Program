{
  "annotations": {"list": []},
  "description": "业务指标面板：登录、匹配、聊天、举报等核心业务计数（Task 8.2.2）",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "登录成功 / 失败（5 分钟速率）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"fillOpacity": 10}}},
      "targets": [
        {"expr": "sum(rate(campuslove_auth_login_total{status=\"success\"}[5m]))", "legendFormat": "成功", "refId": "A"},
        {"expr": "sum(rate(campuslove_auth_login_total{status=\"failed\"}[5m]))", "legendFormat": "失败", "refId": "B"}
      ]
    },
    {
      "title": "匹配成功率",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "green", "value": 0.2}
            ]
          }
        }
      },
      "targets": [
        {"expr": "sum(rate(campuslove_match_total{result=\"matched\"}[5m])) / sum(rate(campuslove_match_total[5m]))", "refId": "A"}
      ]
    },
    {
      "title": "聊天消息发送速率",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"expr": "sum(rate(campuslove_chat_messages_sent_total[5m]))", "refId": "A"}
      ]
    },
    {
      "title": "限流触发次数（5 分钟）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"expr": "sum(rate(campuslove_ratelimit_rejected_total[5m])) by (endpoint)", "legendFormat": "{{endpoint}}", "refId": "A"}
      ]
    },
    {
      "title": "熔断器状态",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "resilience4j_circuitbreaker_state", "format": "table", "instant": true, "refId": "A"}
      ]
    },
    {
      "title": "缓存命中率",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.6},
              {"color": "green", "value": 0.8}
            ]
          }
        }
      },
      "targets": [
        {"expr": "sum(cache_gets_hit_total) / (sum(cache_gets_hit_total) + sum(cache_gets_miss_total))", "refId": "A"}
      ]
    },
    {
      "title": "未处理举报数",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"expr": "campuslove_reports_pending_total", "refId": "A"}
      ]
    },
    {
      "title": "未读反馈数",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"expr": "campuslove_feedback_pending_total", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["campus-love", "business"],
  "time": {"from": "now-6h", "to": "now"},
  "title": "Business Metrics",
  "uid": "business-metrics",
  "version": 1
}
