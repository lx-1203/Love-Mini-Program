[environments.default]
# Replace this with your real JDBC URL.
# MySQL example (R4-00411：库名统一为 campus_love，与 application-real.yml DB_URL 默认值一致；
# 历史曾出现误填另一项目库名 qihang_platform，使用本模板即可避免)：
url = "jdbc:mysql://127.0.0.1:3306/campus_love?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai"

# PostgreSQL example:
# url = "jdbc:postgresql://127.0.0.1:5432/your_database"

# SQL Server example:
# url = "jdbc:sqlserver://127.0.0.1:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true"

user = "your_user"
password = "change_me"
