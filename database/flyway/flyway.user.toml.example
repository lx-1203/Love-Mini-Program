[environments.default]
# Replace this with your real JDBC URL.
# MySQL example (R4-00411：库名统一为 campus_love，与 application-real.yml DB_URL 默认值一致；
# 历史曾出现误填另一项目库名 qihang_platform，使用本模板即可避免)：
url = "jdbc:mysql://127.0.0.1:3306/campus_love?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai"

# PostgreSQL example:
# url = "jdbc:postgresql://127.0.0.1:5432/your_database"

# SQL Server example:
# url = "jdbc:sqlserver://127.0.0.1:1433;databaseName=your_database;encrypt=true;trustServerCertificate=true"

user = "your_user"
password = "change_me"

# 占位符注入（R4-00409：flyway.toml 已移除 admin_openid/admin_nickname 默认值，
# CLI 迁移必须显式注入，否则占位符缺失会报错——这是预期行为，防止弱默认管理员上线）。
# 本地开发示例（本地联调请替换为你的真实 openid / 昵称）：
[flyway.placeholders]
# admin_openid = "local-dev-openid-123456"
# admin_nickname = "系统管理员"
# admin_password_hash = "$2a$10$..."   # BCrypt 哈希，生成：python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt(10)).decode())"
# demo_seed = "false"                    # true 时灌入虚拟用户/演示种子（验收演示环境）
